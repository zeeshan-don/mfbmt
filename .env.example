# ---------------------------------------------------------------------------
# MFBMT Procurement Intelligence — environment template.
# Copy to .env and fill in. Never commit real credentials.
# ---------------------------------------------------------------------------

# Core
DATABASE_URL="file:./dev.db"
APP_URL="http://localhost:3000"
AUTH_SECRET="replace-with-64-hex-characters"
# Encrypts integration credentials stored in the database (32-byte hex).
CREDENTIAL_ENCRYPTION_KEY="replace-with-64-hex-characters"
NODE_ENV="development"

# Background worker (run `npm run worker` alongside the web server)
WORKER_POLL_MS="3000"
# Shared secret for the HTTP job tick endpoint (hosting without a separate worker)
WORKER_SECRET="replace-with-random-string"

# Demo / sample data mode. Set to "true" only in development.
# Time zone used for business dates in the UI (server clock stays UTC)
BUSINESS_TIMEZONE="Asia/Dubai"
DEMO_MODE="true"
SEED_DEMO_DATA="true"

# ---------------------------------------------------------------------------
# AI provider (OpenAI-compatible chat completions API)
# ---------------------------------------------------------------------------
AI_PROVIDER="openai"                # openai | azure-openai | none
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
AI_VISION_MODEL=""

# ---------------------------------------------------------------------------
# WhatsApp Business Platform (Meta Cloud API)
# ---------------------------------------------------------------------------
META_APP_SECRET=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_VERIFY_TOKEN=""
META_GRAPH_API_VERSION="v21.0"

# ---------------------------------------------------------------------------
# Email intake
# ---------------------------------------------------------------------------
EMAIL_INTAKE_PROVIDER="none"        # none | gmail | microsoft365 | inbound_forward
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REDIRECT_URI="http://localhost:3000/api/integrations/gmail/callback"
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"
MICROSOFT_REDIRECT_URI="http://localhost:3000/api/integrations/microsoft/callback"
INBOUND_EMAIL_SECRET=""
COMPANY_EMAIL_FROM=""
# Gmail search used for enquiry intake (only matching messages are read)
EMAIL_FILTER="is:unread newer_than:2d"
# Outlook mail folder
EMAIL_FOLDER="inbox"

# ---------------------------------------------------------------------------
# Web search provider (multi-source supplier discovery)
# ---------------------------------------------------------------------------
WEB_SEARCH_PROVIDER="none"          # none | tavily | serper | brave
TAVILY_API_KEY=""
SERPER_API_KEY=""
BRAVE_SEARCH_API_KEY=""
SEARCH_MAX_RESULTS="8"
SEARCH_REQUEST_TIMEOUT_MS="15000"

# ---------------------------------------------------------------------------
# Optional services
# ---------------------------------------------------------------------------
OCR_PROVIDER="auto"                 # auto | tesseract | none
EXCHANGE_RATE_PROVIDER="none"       # none | exchangerate_host | fixed
EXCHANGE_RATE_API_KEY=""
FIXED_USD_AED="3.6725"
STORAGE_ROOT="./storage"
MAX_UPLOAD_MB="15"
UPLOAD_LINK_TTL_MINUTES="10"
