# MFBMT Procurement Intelligence — environment reference
# Copy to .env and fill in. Values marked (required) have no safe default.
# Never commit .env. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ── Core ─────────────────────────────────────────────────────────────────────
# (required) PostgreSQL. SQLite is not supported by the production datasource.
DATABASE_URL="postgresql://user:password@host:5432/mfbmt?schema=public&sslmode=require"
# (required in production) public https origin used in links and OAuth callbacks.
APP_URL="https://procurement.example.com"
# (required) 32+ random characters. Sessions and signed links.
AUTH_SECRET=""
# (required in production) separate 32+ random characters. AES-256-GCM for stored
# integration credentials. Must differ from AUTH_SECRET.
CREDENTIAL_ENCRYPTION_KEY=""
NODE_ENV="development"
AUTH_SESSION_DAYS="7"
BUSINESS_TIMEZONE="Asia/Dubai"

# Worker
WORKER_POLL_MS="3000"
WORKER_HEALTH_PORT="3001"
WORKER_HEALTH_HOST="0.0.0.0"
# Vercel Cron uses CRON_SECRET; manual calls may use WORKER_SECRET.
CRON_SECRET=""
WORKER_STALE_MS="120000"
WORKER_HEARTBEAT_MS="20000"
# (required if you use /api/jobs/tick instead of a long-running worker)
WORKER_SECRET=""

# QStash (external scheduler; replaces Vercel crons on Hobby plan)
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""
QSTASH_DEV=""

# ── Demo data (development only) ─────────────────────────────────────────────
# Production refuses to start with either set to true.
DEMO_MODE="false"
SEED_DEMO_DATA="false"

# ── AI document reading (optional but recommended) ───────────────────────────
# none | openai | azure-openai | openai-compatible | gemini
AI_PROVIDER="none"
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
# Gemini example (free tier available):
# AI_PROVIDER="gemini"
# AI_API_KEY="your-gemini-key"
# AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
# AI_MODEL="gemini-3.1-flash-lite"
AI_VISION_MODEL=""
# Send unknown senders to the AI provider. Off: unknown senders are classified
# locally and routed to owner review.
AI_FOR_UNKNOWN_SENDERS="false"

# ── WhatsApp (Meta Embedded Signup) ──────────────────────────────────────────
# App-level credentials only. Per-account tokens are stored encrypted in the DB
# after the owner completes Embedded Signup in Settings → WhatsApp.
META_APP_ID=""
META_APP_SECRET=""
META_EMBEDDED_SIGNUP_CONFIG_ID=""
META_EMBEDDED_SIGNUP_CONFIG_ID_COEXISTENCE=""
META_GRAPH_API_VERSION="v23.0"
# (required for the webhook) random string you also enter in the Meta app.
WHATSAPP_VERIFY_TOKEN=""
# Legacy static credentials: leave empty. They are only a fallback for accounts
# connected before Embedded Signup existed.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# ── Email intake ─────────────────────────────────────────────────────────────
# none | gmail | microsoft365 (reported status comes from the real connection)
EMAIL_INTAKE_PROVIDER="none"
EMAIL_AUTO_SYNC="true"
EMAIL_POLL_INTERVAL_MS="120000"
EMAIL_MAX_MESSAGES_PER_RUN="100"
EMAIL_FILTER=""
EMAIL_FOLDER="inbox"
COMPANY_EMAIL_FROM=""

# Gmail (OAuth client + optional Pub/Sub push)
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
# Leave empty to default to ${APP_URL}/api/integrations/gmail/callback
GMAIL_REDIRECT_URI=""
GMAIL_PUBSUB_TOPIC=""
GMAIL_PUBSUB_VERIFICATION_TOKEN=""

# Microsoft 365 / Outlook
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"
MICROSOFT_REDIRECT_URI=""
GRAPH_WEBHOOK_CLIENT_STATE=""
GRAPH_SUBSCRIPTION_MINUTES="4200"

# Forwarding endpoint shared secret
INBOUND_EMAIL_SECRET=""

# ── Supplier web search (optional) ───────────────────────────────────────────
# none | tavily | serper | brave (set multiple keys for automatic fallback)
WEB_SEARCH_PROVIDER="none"
TAVILY_API_KEY=""
SERPER_API_KEY=""
BRAVE_SEARCH_API_KEY=""
SEARCH_MAX_RESULTS="8"
SEARCH_MAX_QUERIES="4"
SEARCH_PAGE_FETCH_LIMIT="5"
SEARCH_REQUEST_TIMEOUT_MS="15000"

# ── OCR (scanned PDFs and photos) ────────────────────────────────────────────
# auto | none. Add "ara" for Arabic: "eng+ara".
OCR_PROVIDER="auto"
OCR_LANGUAGES="eng"
# Optional directory containing pre-baked Tesseract .traineddata.gz files.
OCR_LANG_PATH=""
OCR_PDF_MAX_PAGES="10"

# ── Currency ─────────────────────────────────────────────────────────────────
# none | exchangerate_host | fixed
EXCHANGE_RATE_PROVIDER="fixed"
EXCHANGE_RATE_API_KEY=""
FIXED_USD_AED="3.6725"

# ── Storage ──────────────────────────────────────────────────────────────────
# local | s3  (s3 covers Cloudflare R2, AWS S3, MinIO and other S3 APIs)
# Production MUST use s3 (private bucket). Never rely on Vercel's ephemeral disk.
STORAGE_DRIVER="local"
STORAGE_ROOT="./storage"
# Set true ONLY for a self-hosted deployment with a real mounted persistent volume.
STORAGE_ALLOW_LOCAL_VOLUME="false"

# ── Cloudflare R2 example (private bucket, region auto, account endpoint) ────
# STORAGE_DRIVER="s3"
# S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_BUCKET="<PRIVATE_BUCKET_NAME>"
# S3_ACCESS_KEY_ID="<R2_ACCESS_KEY_ID>"
# S3_SECRET_ACCESS_KEY="<R2_SECRET_ACCESS_KEY>"
# S3_FORCE_PATH_STYLE="false"

# ── AWS S3 example (no endpoint, real region) ────────────────────────────────
# STORAGE_DRIVER="s3"
# S3_ENDPOINT=""
# S3_REGION="eu-central-1"
# S3_BUCKET="<PRIVATE_BUCKET_NAME>"
# S3_ACCESS_KEY_ID="<AWS_ACCESS_KEY_ID>"
# S3_SECRET_ACCESS_KEY="<AWS_SECRET_ACCESS_KEY>"
# S3_FORCE_PATH_STYLE="false"

# Effective upload cap. Server Actions are limited to 12 MB in next.config.ts,
# so a larger value is clamped to 12 rather than failing at the transport layer.
MAX_UPLOAD_MB="12"
UPLOAD_LINK_TTL_MINUTES="10"

# ── Pusher (realtime) ────────────────────────────────────────────────────────
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="ap2"
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="ap2"
