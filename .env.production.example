# MFBMT production environment template.
# Copy to .env, fill every required value, then run: npm run check:config
# Never commit the filled .env.

# ── Core ─────────────────────────────────────────────────────────────────────
# WHERE TO FIND: your PostgreSQL provider (Neon/RDS/Supabase/local). Must be postgresql:// and use sslmode=require in production.
DATABASE_URL="postgresql://user:password@host:5432/mfbmt?schema=public&sslmode=require"
# WHERE TO FIND: your public domain, e.g. https://procurement.yourcompany.com
APP_URL="https://procurement.example.com"
# WHERE TO FIND: generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""
# WHERE TO FIND: generate a different 32+ char secret with the same command; keep it with backups.
CREDENTIAL_ENCRYPTION_KEY=""
# Keep as production.
NODE_ENV="production"
# Session length in days (1-90).
AUTH_SESSION_DAYS="7"
# Business timezone, e.g. Asia/Dubai.
BUSINESS_TIMEZONE="Asia/Dubai"

# ── Worker ───────────────────────────────────────────────────────────────────
# Poll interval in ms.
WORKER_POLL_MS="3000"
# Heartbeat stale threshold in ms.
WORKER_STALE_MS="120000"
WORKER_HEARTBEAT_MS="20000"
# WHERE TO FIND: random string if you use /api/jobs/tick instead of a long-running worker.
WORKER_SECRET=""

# ── Demo data (must stay false in production) ────────────────────────────────
DEMO_MODE="false"
SEED_DEMO_DATA="false"

# ── AI document reading (optional but recommended) ───────────────────────────
# none | openai | azure-openai | openai-compatible | gemini
AI_PROVIDER="none"
# WHERE TO FIND: your AI provider dashboard (OpenAI/ Azure OpenAI / compatible).
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
# Gemini example (free tier): AI_PROVIDER="gemini", AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai", AI_MODEL="gemini-3.1-flash-lite"
AI_VISION_MODEL=""
AI_FOR_UNKNOWN_SENDERS="false"

# ── WhatsApp (Meta Embedded Signup) ──────────────────────────────────────────
# WHERE TO FIND: Meta Developer Portal -> your app -> Settings -> Basic (App ID/Secret).
META_APP_ID=""
META_APP_SECRET=""
# WHERE TO FIND: Meta Developer Portal -> WhatsApp -> Embedded Signup configuration.
META_EMBEDDED_SIGNUP_CONFIG_ID=""
META_EMBEDDED_SIGNUP_CONFIG_ID_COEXISTENCE=""
META_GRAPH_API_VERSION="v23.0"
# WHERE TO FIND: choose a random string; also enter it in the Meta webhook config.
WHATSAPP_VERIFY_TOKEN=""
# Legacy static credentials: leave empty unless migrating an old account.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# ── Email intake ─────────────────────────────────────────────────────────────
# none | gmail | microsoft365
EMAIL_INTAKE_PROVIDER="none"
EMAIL_AUTO_SYNC="true"
EMAIL_POLL_INTERVAL_MS="120000"
EMAIL_MAX_MESSAGES_PER_RUN="100"
EMAIL_FILTER=""
EMAIL_FOLDER="inbox"
# Company sender address for outbound mail.
COMPANY_EMAIL_FROM=""

# Gmail (OAuth client + optional Pub/Sub push)
# WHERE TO FIND: Google Cloud Console -> APIs & Services -> Credentials -> OAuth client.
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
# Leave empty to default to ${APP_URL}/api/integrations/gmail/callback
GMAIL_REDIRECT_URI=""
# WHERE TO FIND: Google Cloud Pub/Sub topic for push notifications.
GMAIL_PUBSUB_TOPIC=""
GMAIL_PUBSUB_VERIFICATION_TOKEN=""

# Microsoft 365 / Outlook
# WHERE TO FIND: Azure Portal -> App registrations.
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"
MICROSOFT_REDIRECT_URI=""
GRAPH_WEBHOOK_CLIENT_STATE=""
GRAPH_SUBSCRIPTION_MINUTES="4200"

# Forwarding endpoint shared secret
INBOUND_EMAIL_SECRET=""

# ── Supplier web search (optional) ───────────────────────────────────────────
# none | tavily | serper | brave (set multiple keys for automatic fallback)
WEB_SEARCH_PROVIDER="none"
# WHERE TO FIND: provider dashboard (Tavily/Serper/Brave).
TAVILY_API_KEY=""
SERPER_API_KEY=""
BRAVE_SEARCH_API_KEY=""
SEARCH_MAX_RESULTS="8"
SEARCH_MAX_QUERIES="4"
SEARCH_PAGE_FETCH_LIMIT="5"
SEARCH_REQUEST_TIMEOUT_MS="15000"

# ── OCR (scanned PDFs and photos) ────────────────────────────────────────────
# auto | none. Add "ara" for Arabic: "eng+ara".
OCR_PROVIDER="auto"
OCR_LANGUAGES="eng"
OCR_PDF_MAX_PAGES="10"

# ── Currency ─────────────────────────────────────────────────────────────────
# none | exchangerate_host | fixed
EXCHANGE_RATE_PROVIDER="fixed"
EXCHANGE_RATE_API_KEY=""
FIXED_USD_AED="3.6725"

# ── Storage ──────────────────────────────────────────────────────────────────
# REQUIRED: s3 (private bucket). Local disk is rejected in production unless a
# real persistent volume is explicitly allowed below.
STORAGE_DRIVER="s3"
# Only used when STORAGE_DRIVER=local.
STORAGE_ROOT="/var/lib/mfbmt/storage"
# Set true ONLY on a self-hosted host with a mounted persistent volume. Never on Vercel.
STORAGE_ALLOW_LOCAL_VOLUME="false"

# -- Cloudflare R2 (recommended for Vercel) -----------------------------------
# WHERE TO FIND: Cloudflare dashboard -> R2 -> Manage API tokens -> S3 credentials.
# Keep the bucket private; do not enable public access or a custom public domain.
S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="<PRIVATE_BUCKET_NAME>"
S3_ACCESS_KEY_ID="<R2_ACCESS_KEY_ID>"
S3_SECRET_ACCESS_KEY="<R2_SECRET_ACCESS_KEY>"
S3_FORCE_PATH_STYLE="false"

# -- AWS S3 alternative -------------------------------------------------------
# Leave S3_ENDPOINT empty and use the bucket's real region (never "auto").
# S3_ENDPOINT=""
# S3_REGION="eu-central-1"
# S3_BUCKET="<PRIVATE_BUCKET_NAME>"
# S3_ACCESS_KEY_ID="<AWS_ACCESS_KEY_ID>"
# S3_SECRET_ACCESS_KEY="<AWS_SECRET_ACCESS_KEY>"
# S3_FORCE_PATH_STYLE="false"

# Effective upload cap. Server Actions are limited to 12 MB in next.config.ts.
MAX_UPLOAD_MB="12"
UPLOAD_LINK_TTL_MINUTES="10"