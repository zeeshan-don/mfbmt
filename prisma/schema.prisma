// Multi-company procurement intelligence — relational schema.
// Provider: PostgreSQL (production + isolated test database).
//
// Every tenant-specific record carries an explicit organizationId. Unique keys
// that used to be global (user email, integration key, document numbers) are
// scoped to the organization so two companies can never collide or read each
// other's records. Statuses are validated Strings (see src/lib/constants.ts)
// and structured payloads are JSON text parsed through zod schemas.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A company. This is the tenant boundary: business reads and writes are scoped
/// to the authenticated user's organization, never to an id from the browser.
model Organization {
  id                     String    @id @default(cuid())
  slug                   String    @unique
  name                   String // trading / display name
  legalName              String?
  taxRegistrationNumber  String?
  country                String    @default("AE")
  timezone               String    @default("Asia/Dubai")
  email                  String?
  phone                  String?
  whatsappNumber         String?
  ownerWhatsappNumber    String?
  whatsappApprovalAlerts Boolean   @default(false)
  messageRetentionDays   Int       @default(0)
  address                String?
  website                String?
  logo                   String? // private storage key or absolute https URL
  defaultCurrency        String    @default("AED")
  quotationPrefix        String    @default("QT")
  quotationValidityDays  Int       @default(14)
  quotationTerms         String?
  minMarginPct           Float     @default(0)
  taxEnabled             Boolean   @default(false)
  taxRatePct             Float     @default(5)
  taxLabel               String    @default("VAT")
  // Whether supplier tax is included in the landed-cost comparison.
  taxInLandedCost        Boolean   @default(false)
  // Explicit procurement policy: does the company hold stock, or source first?
  inventoryMode          String    @default("STOCK_FIRST") // STOCK_FIRST | SOURCING_FIRST
  // GENERAL keeps MFBMT's generic category requirements. INDUSTRIAL enables
  // the versioned OGS industrial extraction and matching schemas.
  procurementProfile     String    @default("GENERAL") // GENERAL | INDUSTRIAL
  inventoryConfiguredAt  DateTime?
  // Set when the owner has finished the first-time setup checklist.
  onboardingCompletedAt  DateTime?
  status                 String    @default("ACTIVE") // ACTIVE | SUSPENDED | ARCHIVED
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  users                    User[]
  sessions                 Session[]
  contacts                 Contact[]
  excludedContacts         ExcludedContact[]
  conversations            Conversation[]
  messages                 Message[]
  attachments              Attachment[]
  documentPackages         DocumentPackage[]
  enquiries                Enquiry[]
  enquiryItems             EnquiryItem[]
  products                 Product[]
  productSpecifications    ProductSpecification[]
  inventoryLocations       InventoryLocation[]
  inventoryStocks          InventoryStock[]
  inventoryMovements       InventoryMovement[]
  suppliers                Supplier[]
  supplierContacts         SupplierContact[]
  supplierProducts         SupplierProduct[]
  searchSessions           SearchSession[]
  searchQueries            SearchQuery[]
  searchResults            SearchResult[]
  researchRuns             ResearchRun[]
  researchQueries          ResearchQuery[]
  researchSources          ResearchSource[]
  researchPages            ResearchPage[]
  researchEvidence         ResearchEvidence[]
  researchCandidates       ResearchCandidate[]
  researchEvents           ResearchEvent[]
  supplierOffers           SupplierOffer[]
  supplierQuotes           SupplierQuote[]
  supplierQuoteItems       SupplierQuoteItem[]
  approvals                Approval[]
  customerQuotations       CustomerQuotation[]
  customerQuotationItems   CustomerQuotationItem[]
  customers                Customer[]
  customerContacts         CustomerContact[]
  pricingRules             PricingRule[]
  materialEquivalences     MaterialEquivalence[]
  integrations             Integration[]
  supplierEmailReplies     SupplierEmailReply[]
  ownerInvitations         OwnerInvitation[]
  mfaChallenges            MfaChallenge[]
  backgroundJobs           BackgroundJob[]
  webhookEvents            WebhookEvent[]
  numberSequences          NumberSequence[]
  auditLogs                AuditLog[]
  notifications            Notification[]
  exchangeRates            ExchangeRate[]
  appSettings              AppSetting[]
  aiUsage                  AiUsage[]
  searchCache              SearchCache[]
  productPackaging         ProductPackaging[]
  stockReservations        StockReservation[]
  outboundMessages         OutboundMessage[]
  salesOrders              SalesOrder[]
  salesOrderLines          SalesOrderLine[]
  purchaseOrders           PurchaseOrder[]
  purchaseOrderLines       PurchaseOrderLine[]
  supplierAcknowledgements SupplierAcknowledgement[]
  goodsReceipts            GoodsReceipt[]
  goodsReceiptLines        GoodsReceiptLine[]
  deliveries               Delivery[]
  deliveryLines            DeliveryLine[]
  customerInvoices         CustomerInvoice[]
  customerInvoiceLines     CustomerInvoiceLine[]
  customerPayments         CustomerPayment[]
  paymentAllocations       PaymentAllocation[]
  supplierBills            SupplierBill[]
  supplierPayments         SupplierPayment[]
  orderStatusEvents        OrderStatusEvent[]
  orderDiscrepancies       OrderDiscrepancy[]

  @@index([status])
}

model User {
  id                     String              @id @default(cuid())
  organizationId         String              @default("__unset__")
  organization           Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email                  String
  name                   String
  passwordHash           String
  role                   String              @default("STAFF") // OWNER | STAFF
  permissions            String              @default("[]") // JSON array, staff only
  isActive               Boolean             @default(true)
  mustChangePassword     Boolean             @default(false)
  passwordChangedAt      DateTime?
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
  // TOTP MFA. The secret is stored encrypted-at-rest by the database provider;
  // it is never returned to a browser after enrollment.
  mfaSecret              String?
  mfaEnabledAt           DateTime?
  mfaRecoveryCodesJson   String              @default("[]")
  mfaLastUsedCounter     Int?
  createdAt              DateTime            @default(now())
  lastLoginAt            DateTime?
  sessions               Session[]
  mfaChallenges          MfaChallenge[]
  approvals              Approval[]          @relation("ApprovalDecider")
  approvedQuotes         CustomerQuotation[] @relation("QuoteApprover")
  pricingExceptions      CustomerQuotation[] @relation("PricingExceptionApprover")
  auditLogs              AuditLog[]
  notifications          Notification[]
  movements              InventoryMovement[]

  @@unique([organizationId, email])
  @@index([organizationId, role, isActive])
}

model Session {
  id             String       @id @default(cuid())
  organizationId String       @default("__unset__")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tokenHash      String       @unique
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  ip             String?
  userAgent      String?

  @@index([userId])
  @@index([organizationId])
}

/// Short-lived, single-use MFA challenge created only after a valid password.
model MfaChallenge {
  id             String       @id @default(cuid())
  organizationId String       @default("__unset__")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash      String       @unique
  expiresAt      DateTime
  attempts       Int          @default(0)
  usedAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Contact {
  id             String         @id @default(cuid())
  organizationId String         @default("__unset__")
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String?
  companyName    String?
  phone          String? // canonical E.164 when known
  email          String? // lower-cased address only, never a display name
  kind           String         @default("UNKNOWN") // CUSTOMER | SUPPLIER | PERSONAL | FAMILY | OTHER | UNKNOWN
  supplierId     String?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  conversations  Conversation[]
  enquiries      Enquiry[]

  @@index([organizationId, phone])
  @@index([organizationId, email])
}

model ExcludedContact {
  id             String       @id @default(cuid())
  organizationId String       @default("__unset__")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  identifier     String // canonical E.164 phone or lower-cased email
  label          String?
  category       String       @default("PERSONAL") // FAMILY | PERSONAL | TRUSTED_SUPPLIER | CUSTOMER | OTHER
  reason         String?
  createdAt      DateTime     @default(now())

  @@unique([organizationId, identifier])
}

model Conversation {
  id             String       @id @default(cuid())
  organizationId String       @default("__unset__")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel        String // WHATSAPP | EMAIL | MANUAL
  externalId     String?
  contactId      String?
  contact        Contact?     @relation(fields: [contactId], references: [id])
  subject        String?
  lastMessageAt  DateTime     @default(now())
  createdAt      DateTime     @default(now())
  messages       Message[]

  @@unique([organizationId, channel, externalId])
  @@index([contactId])
}

model Message {
  id                       String       @id @default(cuid())
  organizationId           String       @default("__unset__")
  organization             Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversationId           String
  conversation             Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  channel                  String // WHATSAPP | EMAIL | MANUAL
  externalMessageId        String // provider id; dedupe key
  direction                String       @default("INBOUND")
  fromAddress              String
  fromName                 String?
  toAddress                String?
  toPhoneNumberId          String? // WhatsApp receiving number, used for routing
  subject                  String?
  body                     String?
  bodyRetained             Boolean      @default(true) // false for excluded contacts
  bodyHash                 String? // SHA-256 of the body, kept as minimal audit
  skipReason               String? // set when the message was not retained
  mediaType                String?
  receivedAt               DateTime     @default(now())
  rawMeta                  String? // JSON, provider metadata (ids only)
  processingStatus         String       @default("RECEIVED") // RECEIVED | IGNORED | QUEUED | PROCESSING | PROCESSED | FAILED | NEEDS_REVIEW
  classification           String? // RFQ | AVAILABILITY | FOLLOW_UP | SUPPLIER | BUSINESS_OTHER | PERSONAL | UNCLEAR
  classificationSource     String? // rule | ai | owner
  classificationConfidence Float?
  classificationReason     String?
  enquiryId                String?      @unique
  enquiry                  Enquiry?     @relation(fields: [enquiryId], references: [id])
  attachments              Attachment[]
  createdAt                DateTime     @default(now())

  @@unique([organizationId, channel, externalMessageId])
  @@index([conversationId, receivedAt])
  @@index([organizationId, processingStatus])
}

model Attachment {
  id               String              @id @default(cuid())
  organizationId   String              @default("__unset__")
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messageId        String?
  message          Message?            @relation(fields: [messageId], references: [id], onDelete: Cascade)
  enquiryId        String?
  enquiry          Enquiry?            @relation(fields: [enquiryId], references: [id])
  supplierReplyId  String?
  supplierReply    SupplierEmailReply? @relation(fields: [supplierReplyId], references: [id], onDelete: SetNull)
  filename         String // sanitized display name
  storedName       String              @unique // random name in storage
  mimeType         String
  detectedMime     String?
  sizeBytes        Int
  sha256           String
  storagePath      String // storage-driver key, never a public URL
  pageCount        Int?
  textExtract      String? // extracted plain text (untrusted content)
  extractionStatus String              @default("PENDING") // PENDING | TEXT_OK | OCR_USED | NEEDS_REVIEW | FAILED
  extractionNote   String?
  // Unified document-processing state. `extractionStatus` is retained for
  // existing readers; these fields add format, quality and retry visibility.
  packageId        String?
  package          DocumentPackage?    @relation(fields: [packageId], references: [id], onDelete: SetNull)
  detectedFormat   String?
  processingStatus String              @default("RECEIVED") // RECEIVED | PROCESSING | COMPLETED | PARTIAL | NEEDS_REVIEW | FAILED | UNSUPPORTED | PASSWORD_PROTECTED
  processingStage  String?
  qualityJson      String?
  tablesJson       String?
  metadataJson     String?
  parserVersion    String?
  promptVersion    String?
  contentVersion   Int                 @default(1)
  processedAt      DateTime?
  failureCode      String?
  failureMessage   String?
  createdAt        DateTime            @default(now())

  @@unique([messageId, sha256])
  @@index([organizationId, enquiryId])
  @@index([supplierReplyId])
  @@index([organizationId, packageId])
  @@index([organizationId, processingStatus])
}

/// One related set of documents received together (an enquiry, a supplier
/// reply, or an uploaded bundle). It records the package-level extraction state
/// and review summary; the individual files remain first-class Attachment rows.
model DocumentPackage {
  id              String       @id @default(cuid())
  organizationId  String       @default("__unset__")
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key             String
  enquiryId       String?
  enquiry         Enquiry?     @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  messageId       String?
  supplierReplyId String?
  status          String       @default("RECEIVED")
  summaryJson     String       @default("{}")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  attachments     Attachment[]

  @@unique([organizationId, key])
  @@index([organizationId, enquiryId])
  @@index([organizationId, supplierReplyId])
}

/// An inbound supplier email reply, stored before any offer is derived from it.
/// Idempotent on the provider's external message id so repeated mailbox syncs
/// never duplicate replies or offers.
model SupplierEmailReply {
  id                String         @id @default(cuid())
  organizationId    String         @default("__unset__")
  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierQuoteId   String?
  supplierQuote     SupplierQuote? @relation(fields: [supplierQuoteId], references: [id], onDelete: SetNull)
  supplierId        String?
  supplier          Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  externalMessageId String
  provider          String // GMAIL | MICROSOFT365
  providerThreadId  String?
  internetMessageId String?
  inReplyTo         String?
  referencesHeader  String?
  fromAddress       String
  fromName          String?
  subject           String?
  bodySummary       String? // retained summary, never a full uncontrolled body dump
  attachmentsJson   String         @default("[]")
  extractedJson     String? // deterministic extraction of the supplier's terms
  extractionStatus  String         @default("PENDING") // PENDING | EXTRACTED | FAILED | NO_TERMS
  matchingStatus    String         @default("UNMATCHED") // MATCHED | NEEDS_REVIEW | UNMATCHED | DUPLICATE
  reviewStatus      String         @default("PENDING") // PENDING | REVIEWED | DISMISSED
  correlationJson   String         @default("{}")
  receivedAt        DateTime       @default(now())
  processedAt       DateTime?
  createdAt         DateTime       @default(now())
  attachments       Attachment[]

  @@unique([organizationId, provider, externalMessageId])
  @@index([organizationId, matchingStatus, receivedAt])
  @@index([supplierQuoteId])
  @@index([supplierId])
}

/// One-time, high-entropy owner invitation. Only the SHA-256 hash is stored; the
/// token is shown once by the provisioning tool and is never emailed or logged
/// by the application. The invitee sets their own password.
model OwnerInvitation {
  id             String       @id @default(cuid())
  organizationId String       @default("__unset__")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  name           String
  role           String       @default("OWNER")
  tokenHash      String       @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdByLabel String       @default("provisioning")
  createdAt      DateTime     @default(now())

  @@index([organizationId, email])
  @@index([expiresAt])
}

model Enquiry {
  id                         String              @id @default(cuid())
  organizationId             String              @default("__unset__")
  organization               Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  publicRef                  String // ENQ-2026-0001
  channel                    String // WHATSAPP | EMAIL | MANUAL | DEMO
  contactId                  String?
  contact                    Contact?            @relation(fields: [contactId], references: [id])
  conversationId             String?
  customerId                 String?
  customer                   Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName               String?
  customerPhone              String?
  customerEmail              String?
  salesOrders                SalesOrder[]
  rawText                    String
  extractedJson              String? // original extraction snapshot; owner corrections are stored separately
  deliveryLocation           String?
  deliveryDate               DateTime?
  // Semantic enquiry context, kept separately from product lines. A requested
  // delivery window is a customer requirement, never a supplier lead time.
  urgency                    String?
  requestedDeliveryTimeframe String?
  customerInstructionsJson   String              @default("[]") // JSON string[]
  currency                   String?
  status                     String              @default("NEW")
  // NEW | EXTRACTING | NEEDS_REVIEW | READY | SOURCING | AWAITING_APPROVAL | APPROVED | QUOTED | CLOSED | REJECTED | IGNORED
  classification             String              @default("RFQ")
  classificationConfidence   Float               @default(0)
  extractionConfidence       Float?
  requiresReview             Boolean             @default(false)
  reviewReason               String?
  isDemo                     Boolean             @default(false)
  createdById                String?
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt
  items                      EnquiryItem[]
  attachments                Attachment[]
  documentPackages           DocumentPackage[]
  approvals                  Approval[]
  quotations                 CustomerQuotation[]
  researchRuns               ResearchRun[]
  Message                    Message?

  @@unique([organizationId, publicRef])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
}

model EnquiryItem {
  id                    String                  @id @default(cuid())
  organizationId        String                  @default("__unset__")
  organization          Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enquiryId             String
  enquiry               Enquiry                 @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  lineNo                Int                     @default(1)
  description           String
  rawText               String?
  category              String?
  brand                 String?
  size                  String?
  material              String?
  grade                 String?
  pressureRating        String?
  schedule              String?
  standard              String?
  unit                  String                  @default("pcs")
  quantity              Float
  missingFields         String                  @default("[]") // JSON string[]
  confidence            String                  @default("{}") // JSON record<field, 0..1>
  sourceRef             String? // page 2 / sheet "Sheet1" row 14 / message
  reviewStatus          String                  @default("PENDING") // PENDING | CONFIRMED | NEEDS_CLARIFICATION | REJECTED
  clarificationQuestion String?
  inventoryStatus       String                  @default("UNCHECKED")
  // UNCHECKED | AVAILABLE | PARTIAL | NONE | CLARIFY | NOT_CONFIGURED
  quantityFromStock     Float                   @default(0)
  quantityToSource      Float                   @default(0)
  inventoryCheckedAt    DateTime?
  stockIsStale          Boolean                 @default(false)
  stockMatchStatus      String? // EXACT | EQUIVALENT | POSSIBLE | INSUFFICIENT | NO_MATCH
  sourcingStatus        String                  @default("NOT_STARTED")
  // NOT_STARTED | QUEUED | SEARCHING | RESULTS_READY | AWAITING_APPROVAL | APPROVED | NO_RESULTS | FAILED | NOT_REQUIRED
  matchedProductId      String?
  matchedStockJson      String? // JSON snapshot of stock rows used for the decision
  extractedJson         String? // original extracted values for this line
  // Versioned OGS industrial specification (see src/lib/catalog/industrialSpec.ts).
  // Null for MFBMT lines that use the generic fastener/generic category engine.
  industrialSpecJson    String?
  approvedOfferId       String? // supplier offer approved by the owner
  // Structured fastener specification (versioned JSON, see src/lib/fasteners/spec.ts).
  // Core attributes are duplicated into columns for filtering and indexing.
  fastenerSpecJson      String?
  fastenerType          String?
  diameter              String?
  threadSeries          String?
  pitchMm               Float?
  lengthMm              Float?
  propertyClass         String?
  finish                String?
  specSource            String                  @default("EXTRACTED") // EXTRACTED | MANUAL | SUPPLIER_CONFIRMED
  specConfirmedAt       DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  offers                SupplierOffer[]
  salesOrderLines       SalesOrderLine[]
  searchSessions        SearchSession[]
  supplierQuotes        SupplierQuote[]
  quotationItems        CustomerQuotationItem[]
  researchRuns          ResearchRun[]

  @@index([enquiryId])
  @@index([organizationId, sourcingStatus])
  @@index([fastenerType, diameter])
}

model Product {
  id                 String                 @id @default(cuid())
  organizationId     String                 @default("__unset__")
  organization       Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sku                String
  name               String
  category           String
  brand              String?
  material           String?
  grade              String?
  size               String?
  pressureRating     String?
  schedule           String?
  standard           String?
  unit               String                 @default("pcs")
  specs              String                 @default("{}") // JSON free-form extra attributes
  fastenerSpecJson   String? // validated fastener specification (see src/lib/fasteners/spec.ts)
  industrialSpecJson String? // validated OGS industrial specification (versioned JSON)
  notes              String?
  isDemo             Boolean                @default(false)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  specifications     ProductSpecification[]
  packaging          ProductPackaging[]
  stocks             InventoryStock[]
  movements          InventoryMovement[]
  supplierProducts   SupplierProduct[]

  @@unique([organizationId, sku])
  @@index([organizationId, category])
}

model ProductSpecification {
  id             String       @id @default(cuid())
  organizationId String       @default("__unset__")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  key            String
  value          String

  @@unique([productId, key])
  @@index([organizationId])
}

model InventoryLocation {
  id             String              @id @default(cuid())
  organizationId String              @default("__unset__")
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  isDemo         Boolean             @default(false)
  stocks         InventoryStock[]
  movements      InventoryMovement[]

  @@unique([organizationId, code])
}

model InventoryStock {
  id               String            @id @default(cuid())
  organizationId   String            @default("__unset__")
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId        String
  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  locationId       String
  location         InventoryLocation @relation(fields: [locationId], references: [id])
  quantityOnHand   Float             @default(0)
  quantityReserved Float             @default(0)
  source           String            @default("MANUAL") // IMPORT | MANUAL | DEMO | ADJUSTMENT
  lastUpdatedAt    DateTime          @default(now())

  @@unique([productId, locationId])
  @@index([organizationId, productId])
}

model InventoryMovement {
  id             String             @id @default(cuid())
  organizationId String             @default("__unset__")
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId      String
  product        Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  locationId     String?
  location       InventoryLocation? @relation(fields: [locationId], references: [id])
  delta          Float
  reason         String
  refType        String?
  refId          String?
  userId         String?
  user           User?              @relation(fields: [userId], references: [id])
  createdAt      DateTime           @default(now())

  @@index([productId, createdAt])
  @@index([organizationId])
}

model ResearchRun {
  id                 String              @id @default(cuid())
  organizationId     String              @default("__unset__")
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enquiryId          String
  enquiry            Enquiry             @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  enquiryItemId      String?
  enquiryItem        EnquiryItem?        @relation(fields: [enquiryItemId], references: [id], onDelete: Cascade)
  /// Set while the run is active, cleared on every terminal state. The unique
  /// key prevents two workers from starting the same item concurrently.
  activeKey          String?             @unique
  mode               String              @default("DEEP")
  status             String              @default("QUEUED")
  // QUEUED | PLANNING | SEARCHING | INVESTIGATING | ANALYZING | FOLLOW_UP | COMPLETED | PARTIAL | FAILED | CANCELLED
  stage              String              @default("QUEUED")
  iteration          Int                 @default(0)
  planJson           String              @default("{}")
  limitsJson         String              @default("{}")
  summaryJson        String              @default("{}")
  reportJson         String              @default("{}")
  coverageJson       String              @default("[]")
  budgetAed          Float?
  estimatedCostUsd   Float               @default(0)
  searchRequests     Int                 @default(0)
  pageFetches        Int                 @default(0)
  documentsProcessed Int                 @default(0)
  aiCalls            Int                 @default(0)
  inputTokens        Int                 @default(0)
  outputTokens       Int                 @default(0)
  error              String?
  startedAt          DateTime            @default(now())
  completedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  queries            ResearchQuery[]
  sources            ResearchSource[]
  pages              ResearchPage[]
  evidence           ResearchEvidence[]
  candidates         ResearchCandidate[]
  events             ResearchEvent[]

  @@index([organizationId, status])
  @@index([enquiryId])
  @@index([enquiryItemId])
  @@index([organizationId, createdAt])
}

model ResearchQuery {
  id               String       @id @default(cuid())
  organizationId   String       @default("__unset__")
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runId            String
  run              ResearchRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  iteration        Int          @default(1)
  round            Int          @default(1)
  query            String
  productTarget    String?
  objective        String?
  location         String?
  requiredEvidence String?
  category         String?
  reason           String?
  provider         String       @default("")
  status           String       @default("QUEUED") // QUEUED | OK | FAILED | SKIPPED | RATE_LIMITED | NOT_CONFIGURED
  resultCount      Int          @default(0)
  error            String?
  createdAt        DateTime     @default(now())

  @@unique([runId, query, provider])
  @@index([runId, iteration])
  @@index([organizationId])
}

model ResearchSource {
  id             String       @id @default(cuid())
  organizationId String       @default("__unset__")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runId          String
  run            ResearchRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  provider       String
  queryId        String?
  sourceUrl      String?
  domain         String?
  title          String
  snippet        String?
  supplierName   String?
  sourceType     String       @default("SEARCH_RESULT")
  evidenceJson   String       @default("{}")
  retrievedAt    DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@index([runId, domain])
  @@index([organizationId])
}

model ResearchPage {
  id               String             @id @default(cuid())
  organizationId   String             @default("__unset__")
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runId            String
  run              ResearchRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  candidateKey     String?
  url              String
  finalUrl         String?
  domain           String?
  title            String?
  pageType         String             @default("OTHER")
  status           String             @default("QUEUED") // QUEUED | FETCHED | FAILED | SKIPPED | ROBOTS_DISALLOWED | REJECTED
  httpStatus       Int?
  contentType      String?
  contentHash      String?
  excerpt          String?
  text             String?
  linksJson        String             @default("[]")
  documentLocation String?
  pageCount        Int?
  fetchedAt        DateTime?
  createdAt        DateTime           @default(now())
  evidence         ResearchEvidence[]

  @@unique([runId, url])
  @@index([runId, candidateKey])
  @@index([organizationId])
}

model ResearchEvidence {
  id                 String             @id @default(cuid())
  organizationId     String             @default("__unset__")
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runId              String
  run                ResearchRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  candidateId        String?
  candidate          ResearchCandidate? @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  pageId             String?
  page               ResearchPage?      @relation(fields: [pageId], references: [id], onDelete: SetNull)
  field              String
  claim              String
  value              String?
  sourceUrl          String
  pageTitle          String?
  sourceType         String             @default("PAGE")
  excerpt            String?
  documentLocation   String?
  pageNumber         Int?
  sheetName          String?
  rowNumber          Int?
  retrievedAt        DateTime           @default(now())
  extractionMethod   String             @default("DETERMINISTIC")
  verificationStatus String             @default("SUPPORTED")
  createdAt          DateTime           @default(now())

  @@index([runId, candidateId])
  @@index([organizationId])
}

model ResearchCandidate {
  id                    String             @id @default(cuid())
  organizationId        String             @default("__unset__")
  organization          Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runId                 String
  run                   ResearchRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  candidateKey          String
  canonicalName         String
  domain                String?
  website               String?
  description           String?
  classification        String? // MANUFACTURER | DISTRIBUTOR | STOCKIST | TRADER | UNKNOWN
  country               String?
  city                  String?
  contactJson           String             @default("{}")
  productCategoriesJson String             @default("[]")
  capabilitiesJson      String             @default("[]")
  certificationsJson    String             @default("[]")
  aliasesJson           String             @default("[]")
  branchesJson          String             @default("[]")
  matchStatus           String             @default("UNVERIFIED") // EXACT | COMPATIBLE | POSSIBLE | UNVERIFIED | NO_MATCH
  matchJson             String             @default("{}")
  confidence            Float              @default(0)
  evidenceCount         Int                @default(0)
  pageCount             Int                @default(0)
  supplierId            String?
  supplier              Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  status                String             @default("NEW") // NEW | APPROVED | IRRELEVANT
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  evidence              ResearchEvidence[]

  @@unique([runId, candidateKey])
  @@index([runId, matchStatus])
  @@index([organizationId])
}

model ResearchEvent {
  id             String       @id @default(cuid())
  organizationId String       @default("__unset__")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runId          String
  run            ResearchRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  iteration      Int          @default(0)
  stage          String
  level          String       @default("INFO")
  message        String
  metaJson       String       @default("{}")
  createdAt      DateTime     @default(now())

  @@index([runId, createdAt])
  @@index([organizationId])
}

model Supplier {
  id                  String               @id @default(cuid())
  organizationId      String               @default("__unset__")
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                String
  website             String?
  /// Normalized website host, used to deduplicate discovered prospects.
  domain              String?
  country             String?
  city                String?
  address             String?
  paymentTerms        String?
  currencies          String               @default("[]")
  typicalLeadTimeDays Int?
  lastQuotedAt        DateTime?
  doNotContact        Boolean              @default(false)
  discoveredFromUrl   String?
  discoveredAt        DateTime?
  bouncedAt           DateTime?
  bounceReason        String?
  contactPerson       String?
  email               String?
  phone               String?
  whatsapp            String?
  categories          String               @default("[]") // JSON string[]
  brands              String               @default("[]") // JSON string[]
  status              String               @default("ACTIVE") // ACTIVE | PAUSED | BLOCKED | UNVERIFIED
  identityStatus      String               @default("UNVERIFIED") // UNVERIFIED | DOMAIN_OBSERVED | CONTACT_CONFIRMED | VERIFIED
  notes               String?
  lastVerifiedAt      DateTime?
  isDemo              Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  contacts            SupplierContact[]
  products            SupplierProduct[]
  offers              SupplierOffer[]
  quotes              SupplierQuote[]
  researchCandidates  ResearchCandidate[]
  emailReplies        SupplierEmailReply[]
  PurchaseOrder       PurchaseOrder[]
  SupplierBill        SupplierBill[]

  @@index([organizationId, name])
  @@index([organizationId, domain])
}

model SupplierContact {
  id             String       @id @default(cuid())
  organizationId String       @default("__unset__")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierId     String
  supplier       Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  name           String
  role           String?
  email          String?
  phone          String?
  whatsapp       String?
  sourceUrl      String?
  retrievedAt    DateTime?
  isPrimary      Boolean      @default(false)

  @@index([supplierId])
  @@index([organizationId])
}

model SupplierProduct {
  id             String       @id @default(cuid())
  organizationId String       @default("__unset__")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierId     String
  supplier       Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product?     @relation(fields: [productId], references: [id])
  title          String
  description    String?
  sku            String?
  specs          String       @default("{}")
  unitPrice      Float?
  currency       String?
  moq            Float?
  availability   String?
  sourceUrl      String?
  lastSeenAt     DateTime     @default(now())
  isDemo         Boolean      @default(false)

  @@index([supplierId])
  @@index([organizationId])
}

model SearchSession {
  id             String         @id @default(cuid())
  organizationId String         @default("__unset__")
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enquiryItemId  String
  enquiryItem    EnquiryItem    @relation(fields: [enquiryItemId], references: [id], onDelete: Cascade)
  status         String         @default("QUEUED") // QUEUED | RUNNING | COMPLETED | PARTIAL | FAILED | CANCELLED
  sourcesJson    String         @default("[]") // adapter coverage report
  summaryJson    String         @default("{}") // counts + notes
  error          String?
  startedAt      DateTime       @default(now())
  completedAt    DateTime?
  queries        SearchQuery[]
  results        SearchResult[]

  @@index([enquiryItemId])
  @@index([organizationId])
}

model SearchQuery {
  id             String        @id @default(cuid())
  organizationId String        @default("__unset__")
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessionId      String
  session        SearchSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  adapter        String
  query          String
  status         String        @default("QUEUED") // OK | FAILED | SKIPPED | RATE_LIMITED | NOT_CONFIGURED
  resultCount    Int           @default(0)
  error          String?
  createdAt      DateTime      @default(now())

  @@index([sessionId])
  @@index([organizationId])
}

model SearchResult {
  id             String         @id @default(cuid())
  organizationId String         @default("__unset__")
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessionId      String
  session        SearchSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  adapter        String
  sourceUrl      String?
  supplierId     String?
  supplierName   String?
  title          String
  snippet        String?
  priceText      String?
  currency       String?
  moq            Float?
  availability   String?
  evidenceJson   String         @default("{}") // specifications found + extraction notes
  matchStatus    String         @default("INSUFFICIENT") // EXACT | EQUIVALENT | POSSIBLE | INSUFFICIENT | NO_MATCH
  confidence     Float          @default(0)
  retrievedAt    DateTime       @default(now())
  isDemo         Boolean        @default(false)
  offer          SupplierOffer?

  @@index([sessionId])
  @@index([organizationId])
}

model SupplierOffer {
  id                  String                  @id @default(cuid())
  organizationId      String                  @default("__unset__")
  organization        Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enquiryItemId       String
  enquiryItem         EnquiryItem             @relation(fields: [enquiryItemId], references: [id], onDelete: Cascade)
  supplierId          String?
  supplier            Supplier?               @relation(fields: [supplierId], references: [id])
  supplierName        String
  searchResultId      String?                 @unique
  searchResult        SearchResult?           @relation(fields: [searchResultId], references: [id])
  productTitle        String
  matchStatus         String                  @default("POSSIBLE") // EXACT | EQUIVALENT | POSSIBLE | INSUFFICIENT | NO_MATCH
  unitPrice           Float?
  currency            String?
  quantityAvailable   Float?
  moq                 Float?
  shippingCost        Float?
  otherCharges        Float?
  taxes               Float?
  leadTimeDays        Int?
  deliveryLocation    String?
  validityDate        DateTime?
  paymentTerms        String?
  status              String                  @default("DISCOVERED")
  // DISCOVERED | LISTING_FOUND | POSSIBLE_MATCH | VERIFIED | CONTACTED | QUOTE_RECEIVED | PRICE_CONFIRMED | EXPIRED | UNAVAILABLE
  sourceType          String                  @default("PUBLIC_WEB") // PUBLIC_WEB | INTERNAL_DB | SUPPLIER_QUOTE | MANUAL | MARKETPLACE
  sourceUrl           String?
  quotedAt            DateTime?
  quoteRef            String?
  verificationStatus  String                  @default("UNVERIFIED") // UNVERIFIED | VERIFIED | PARTIAL | EXPIRED
  landedCostJson      String                  @default("{}")
  isEligible          Boolean                 @default(false)
  ineligibilityReason String?
  evidenceJson        String                  @default("{}")
  // Specifications the supplier actually stated, validated against the fastener schema.
  offeredSpecJson     String?
  // Actual quantity MFBMT would have to buy (MOQ applied), disclosed to the owner.
  procurementQuantity Float?
  isDemo              Boolean                 @default(false)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  quoteItemId         String?                 @unique
  quoteItem           SupplierQuoteItem?      @relation(fields: [quoteItemId], references: [id])
  quotationItems      CustomerQuotationItem[]
  purchaseOrderLines  PurchaseOrderLine[]

  @@index([enquiryItemId])
  @@index([organizationId])
}

model SupplierQuote {
  id                String               @id @default(cuid())
  organizationId    String               @default("__unset__")
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierId        String
  supplier          Supplier             @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  enquiryItemId     String?
  enquiryItem       EnquiryItem?         @relation(fields: [enquiryItemId], references: [id])
  token             String               @unique
  status            String               @default("REQUESTED") // DRAFT | REQUESTED | AWAITING_APPROVAL | SENT | RESPONDED | DECLINED | EXPIRED
  reminderSentAt    DateTime?
  reminderCount     Int                  @default(0)
  bounceAt          DateTime?
  bounceReason      String?
  /// Opaque reference embedded in the outgoing RFQ subject, used to correlate replies.
  correlationToken  String?              @unique
  /// Provider thread/message ids captured from the send response when available.
  providerThreadId  String?
  providerMessageId String?
  channel           String? // email | whatsapp | manual
  sentTo            String?
  lastError         String?
  subject           String?
  messageBody       String?
  /// Deterministic + AI quality findings for the supplier-facing draft (JSON).
  draftQualityJson  String?
  sentAt            DateTime?
  respondedAt       DateTime?
  expiresAt         DateTime
  responseNote      String?
  createdAt         DateTime             @default(now())
  items             SupplierQuoteItem[]
  emailReplies      SupplierEmailReply[]

  @@index([supplierId])
  @@index([organizationId])
}

model SupplierQuoteItem {
  id             String         @id @default(cuid())
  organizationId String         @default("__unset__")
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quoteId        String
  quote          SupplierQuote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  description    String
  specs          String?
  quantity       Float
  unit           String         @default("pcs")
  unitPrice      Float?
  currency       String?
  moq            Float?
  leadTimeDays   Int?
  shippingCost   Float?
  otherCharges   Float?
  taxes          Float?
  validityDate   DateTime?
  notes          String?
  offer          SupplierOffer?

  @@index([organizationId])
}

model Approval {
  id             String       @id @default(cuid())
  organizationId String       @default("__unset__")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           String // SOURCING | SUPPLIER_QUOTE_SEND | CUSTOMER_QUOTATION | PRICING_OVERRIDE
  entityType     String
  entityId       String
  enquiryId      String?
  enquiry        Enquiry?     @relation(fields: [enquiryId], references: [id])
  requestedBy    String       @default("SYSTEM")
  status         String       @default("PENDING") // PENDING | APPROVED | REJECTED | CHANGES_REQUESTED | CANCELLED
  decidedById    String?
  decidedBy      User?        @relation("ApprovalDecider", fields: [decidedById], references: [id])
  reason         String?
  riskNotes      String?
  payloadJson    String       @default("{}")
  createdAt      DateTime     @default(now())
  decidedAt      DateTime?

  // Enforced in the database by a partial unique index: one PENDING approval
  // per subject within an organization, while decided rows remain as history.
  @@index([type, entityId, status])
  @@index([organizationId, status, createdAt])
  @@index([enquiryId])
}

/// Customer master. Enquiries and quotations link here so quote history survives
/// changes to the original phone number or contact name.
model Customer {
  id             String              @id @default(cuid())
  organizationId String              @default("__unset__")
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  email          String?
  phone          String?
  taxNumber      String?
  country        String?
  tier           String              @default("STANDARD") // STANDARD | SILVER | GOLD | STRATEGIC
  notes          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  contacts       CustomerContact[]
  enquiries      Enquiry[]
  quotations     CustomerQuotation[]
  salesOrders    SalesOrder[]
  invoices       CustomerInvoice[]
  payments       CustomerPayment[]

  @@index([organizationId, name])
  @@index([organizationId, email])
}

model CustomerContact {
  id             String       @id @default(cuid())
  organizationId String       @default("__unset__")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name           String
  role           String?
  email          String?
  phone          String?
  isPrimary      Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([customerId])
  @@index([organizationId])
}

model CustomerQuotation {
  id                     String                  @id @default(cuid())
  organizationId         String                  @default("__unset__")
  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enquiryId              String
  enquiry                Enquiry                 @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  customerId             String?
  customer               Customer?               @relation(fields: [customerId], references: [id], onDelete: SetNull)
  quoteNumber            String
  version                Int                     @default(1)
  customerName           String
  customerPhone          String?
  customerEmail          String?
  currency               String
  subtotal               Float                   @default(0)
  taxAmount              Float                   @default(0)
  total                  Float                   @default(0)
  internalCostTotal      Float?
  internalCostComplete   Boolean                 @default(false)
  terms                  String?
  notes                  String?
  validityDate           DateTime?
  status                 String                  @default("DRAFT") // DRAFT | AWAITING_APPROVAL | APPROVED | SENT | VOID
  changeSummary          String?
  outcome                String? // WON | LOST | NO_RESPONSE
  outcomeReason          String?
  outcomeAt              DateTime?
  marginExceptionReason  String?
  approvedById           String?
  approvedBy             User?                   @relation("QuoteApprover", fields: [approvedById], references: [id])
  approvedAt             DateTime?
  // Explicit owner approval to issue a quotation that contains unpriced lines.
  pricingExceptionById   String?
  pricingExceptionBy     User?                   @relation("PricingExceptionApprover", fields: [pricingExceptionById], references: [id])
  pricingExceptionAt     DateTime?
  pricingExceptionReason String?
  sentAt                 DateTime?
  sentChannel            String? // EMAIL | WHATSAPP | MANUAL
  sentTo                 String?
  sendError              String?
  pdfPath                String?
  pdfGeneratedAt         DateTime?
  isDemo                 Boolean                 @default(false)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  items                  CustomerQuotationItem[]
  stockReservations      StockReservation[]
  salesOrders            SalesOrder[]

  @@unique([organizationId, quoteNumber])
  @@unique([enquiryId, version])
  @@index([enquiryId])
  @@index([organizationId])
  @@index([customerId])
}

model CustomerQuotationItem {
  id              String            @id @default(cuid())
  organizationId  String            @default("__unset__")
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotationId     String
  quotation       CustomerQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  description     String
  specs           String?
  quantity        Float
  unit            String            @default("pcs")
  // Cost and price are nullable on purpose: an unknown cost stays unknown and an
  // unpriced line can never become a silent zero.
  costPrice       Float?
  unitPrice       Float?
  lineTotal       Float?
  priceStatus     String            @default("UNPRICED") // PRICED | UNPRICED
  costStatus      String            @default("UNKNOWN") // COMPLETE | PARTIAL | UNKNOWN
  countryOfOrigin String?
  certification   String?
  leadTimeDays    Int?
  deliveryTerms   String?
  validityDate    DateTime?
  technicalNotes  String?
  pricingSource   String? // RULE | MANUAL | OWNER_OVERRIDE
  overrideReason  String?
  overrideById    String?
  overrideAt      DateTime?
  stockQuantity   Float             @default(0)
  procureQuantity Float             @default(0)
  stockUnitCost   Float? // unknown when the company has no recorded acquisition cost
  procureUnitCost Float?
  costIncomplete  Boolean           @default(true)
  supplierOfferId String?
  supplierOffer   SupplierOffer?    @relation(fields: [supplierOfferId], references: [id])
  enquiryItemId   String?
  enquiryItem     EnquiryItem?      @relation(fields: [enquiryItemId], references: [id])

  @@index([organizationId])
}

model PricingRule {
  id             String       @id @default(cuid())
  organizationId String       @default("__unset__")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scope          String       @default("GLOBAL") // GLOBAL | CATEGORY
  category       String?
  customerTier   String? // STANDARD | SILVER | GOLD | STRATEGIC
  type           String       @default("PERCENT_MARKUP") // PERCENT_MARKUP | FIXED_MARKUP | MANUAL
  value          Float        @default(0)
  priority       Int          @default(100)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

/// Explicitly owner-approved material equivalences (e.g. SS316 ↔ SS316L).
/// Without a row here, two different materials are never treated as equivalent.
model MaterialEquivalence {
  id                String       @id @default(cuid())
  organizationId    String       @default("__unset__")
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedMaterial String
  offeredMaterial   String
  requestedGrade    String       @default("")
  offeredGrade      String       @default("")
  reason            String?
  approvedById      String?
  approvedAt        DateTime     @default(now())
  isActive          Boolean      @default(true)

  @@unique([organizationId, requestedMaterial, offeredMaterial, requestedGrade, offeredGrade])
}

model Integration {
  id             String       @id @default(cuid())
  organizationId String       @default("__unset__")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String
  name           String
  status         String       @default("NOT_CONFIGURED")
  configJson     String       @default("{}")
  secretsJson    String       @default("{}")
  accountLabel   String?
  lastCheckedAt  DateTime?
  lastSuccessAt  DateTime?
  nextSyncAt     DateTime?
  lastError      String?
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, key])
}

/// Durable worker liveness registry. Written by each worker process on every
/// poll and while it runs a job; never inferred from a job heartbeat, which is
/// cleared when a job finishes.
model WorkerHeartbeat {
  id          String   @id @default(cuid())
  workerId    String   @unique
  processName String?
  startedAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  metaJson    String   @default("{}")
  updatedAt   DateTime @updatedAt

  @@index([lastSeenAt])
}

model BackgroundJob {
  id             String       @id @default(cuid())
  organizationId String       @default("__unset__")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           String
  payloadJson    String       @default("{}")
  status         String       @default("QUEUED")
  attempts       Int          @default(0)
  maxAttempts    Int          @default(3)
  idempotencyKey String
  progress       String?
  runAfter       DateTime     @default(now())
  lockedAt       DateTime?
  lockedBy       String?
  leaseExpiresAt DateTime?
  heartbeatAt    DateTime?
  deadLetteredAt DateTime?
  lastError      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, idempotencyKey])
  @@index([status, runAfter])
  @@index([status, leaseExpiresAt])
  @@index([organizationId, status])
}

/// Durable webhook receipt. A provider delivery is acknowledged only after its
/// row exists, and the unique key makes provider retries idempotent per tenant.
model WebhookEvent {
  id             String       @id @default(cuid())
  organizationId String       @default("__unset__")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider       String // WHATSAPP | GMAIL | MICROSOFT365 | INBOUND_EMAIL
  externalId     String
  payloadHash    String
  status         String       @default("RECEIVED") // RECEIVED | QUEUED | PROCESSED | FAILED
  error          String?
  receivedAt     DateTime     @default(now())
  processedAt    DateTime?

  @@unique([organizationId, provider, externalId])
  @@index([status, receivedAt])
}

/// Monotonic counter used for gap-free, race-free document numbering per tenant.
model NumberSequence {
  organizationId String       @default("__unset__")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scope          String // e.g. QT-2026 / ENQ-2026
  value          Int          @default(0)

  @@id([organizationId, scope])
}

model AuditLog {
  id             String        @id @default(cuid())
  // Null only for platform/auth events that happen before a tenant is known
  // (for example a failed sign-in). Every business event carries the tenant.
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorId        String?
  actor          User?         @relation(fields: [actorId], references: [id])
  actorLabel     String        @default("system")
  action         String
  entityType     String
  entityId       String?
  metaJson       String        @default("{}")
  ip             String?
  createdAt      DateTime      @default(now())

  @@index([entityType, entityId])
  @@index([organizationId, createdAt])
}

model Notification {
  id             String       @id @default(cuid())
  organizationId String       @default("__unset__")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id])
  type           String
  title          String
  body           String?
  link           String?
  isRead         Boolean      @default(false)
  channelsJson   String       @default("{}")
  deliveryStatus String       @default("IN_APP") // IN_APP | WHATSAPP_SENT | WHATSAPP_FAILED | WHATSAPP_OUTSIDE_WINDOW
  createdAt      DateTime     @default(now())

  @@index([isRead])
  @@index([organizationId, createdAt])
}

/// Provider-reported token usage. Cost is deterministic (configured rates), not AI-estimated.
model AiUsage {
  id               String       @id @default(cuid())
  organizationId   String       @default("__unset__")
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobType          String
  provider         String
  model            String
  inputTokens      Int          @default(0)
  outputTokens     Int          @default(0)
  estimatedCostUsd Float?
  enquiryId        String?
  success          Boolean      @default(true)
  error            String?
  createdAt        DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, jobType])
}

/// Organization-scoped search/page cache. Keys include the normalized query.
model SearchCache {
  id             String       @id @default(cuid())
  organizationId String       @default("__unset__")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cacheKey       String
  kind           String       @default("SEARCH") // SEARCH | PAGE
  payloadJson    String
  sourceUrl      String?
  fetchedAt      DateTime     @default(now())
  expiresAt      DateTime

  @@unique([organizationId, cacheKey])
  @@index([organizationId, expiresAt])
}

model ExchangeRate {
  id             String       @id @default(cuid())
  organizationId String       @default("__unset__")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  base           String
  quote          String
  rate           Float
  source         String
  fetchedAt      DateTime     @default(now())

  @@unique([organizationId, base, quote, fetchedAt])
}

model AppSetting {
  organizationId String       @default("__unset__")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String
  value          String
  updatedAt      DateTime     @updatedAt

  @@id([organizationId, key])
}

/// Explicit product packaging factors. A row is written only when someone
/// configures it, e.g. 1 box = 20 pcs. Without a row, the conversion is unknown.
model ProductPackaging {
  id             String       @id @default(cuid())
  organizationId String       @default("__unset__")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  unit           String
  baseUnit       String
  factor         Float
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([productId, unit])
  @@index([organizationId, productId])
}

/// A durable temporary hold on inventory for a quotation line. It is a hold,
/// not a purchase commitment: approval does not create an order. Allocations
/// are stored per location so aggregated stock can be released exactly once.
model StockReservation {
  id              String             @id @default(cuid())
  organizationId  String             @default("__unset__")
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotationId     String?
  quotation       CustomerQuotation? @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  quotationItemId String?
  enquiryItemId   String?
  productId       String
  quantity        Float
  allocationsJson String             @default("[]")
  status          String             @default("ACTIVE") // ACTIVE | RELEASED | EXPIRED | COMMITTED
  idempotencyKey  String
  expiresAt       DateTime
  releasedAt      DateTime?
  releaseReason   String?
  overrideReason  String?
  createdById     String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status, expiresAt])
  @@index([quotationId])
  @@index([productId])
}

/// Durable outbound message ledger. The row is claimed atomically before a
/// provider call, so two workers can never both transmit the same message.
/// SENDING with an expired lease becomes UNKNOWN and is never retried blindly.
model OutboundMessage {
  id                String       @id @default(cuid())
  organizationId    String       @default("__unset__")
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  operationKey      String
  kind              String // SUPPLIER_RFQ | SUPPLIER_REMINDER | CUSTOMER_QUOTATION | NOTIFICATION
  channel           String // EMAIL | WHATSAPP | MANUAL
  recipient         String
  subject           String?
  body              String
  status            String       @default("PENDING") // PENDING | SENDING | SENT | FAILED_SAFE | UNKNOWN | CANCELLED
  attempts          Int          @default(0)
  maxAttempts       Int          @default(4)
  claimToken        String?
  claimedAt         DateTime?
  leaseExpiresAt    DateTime?
  nextAttemptAt     DateTime?
  providerMessageId String?
  providerThreadId  String?
  sentAt            DateTime?
  lastError         String?
  reconciledAt      DateTime?
  relatedType       String?
  relatedId         String?
  metadataJson      String       @default("{}")
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([organizationId, operationKey])
  @@index([organizationId, status])
  @@index([status, leaseExpiresAt])
}

/**
 * ── Order-to-closure lifecycle ─────────────────────────────────────────────
 * Sales orders, supplier purchase orders, receipts, deliveries, invoices and
 * payments are separate durable records. Every financial amount is a Decimal,
 * every document number is unique per tenant, and every conversion carries an
 * idempotency key so retries cannot duplicate commercial commitments.
 */

model SalesOrder {
  id                     String             @id @default(cuid())
  organizationId         String             @default("__unset__")
  organization           Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orderNumber            String
  idempotencyKey         String
  status                 String             @default("ORDER_CONFIRMED")
  // ORDER_CONFIRMED | PROCUREMENT_IN_PROGRESS | PARTIALLY_RECEIVED | READY_TO_DISPATCH | PARTIALLY_DELIVERED | DELIVERED | PARTIALLY_INVOICED | INVOICED | PARTIALLY_PAID | SETTLED | CLOSED | CANCELLED
  enquiryId              String?
  enquiry                Enquiry?           @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  quotationId            String
  quotation              CustomerQuotation  @relation(fields: [quotationId], references: [id])
  quotationVersion       Int
  customerId             String?
  customer               Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName           String
  customerEmail          String?
  customerPhone          String?
  customerPoNumber       String?
  customerPoReference    String?
  acceptanceSource       String             @default("CUSTOMER_PO") // CUSTOMER_PO | EMAIL_ACCEPTANCE | OWNER_RECORDED
  acceptanceEvidenceJson String             @default("{}")
  resolutionJson         String             @default("{}")
  acceptedAt             DateTime           @default(now())
  acceptedById           String?
  currency               String
  subtotal               Decimal            @default(0) @db.Decimal(18, 4)
  taxAmount              Decimal            @default(0) @db.Decimal(18, 4)
  total                  Decimal            @default(0) @db.Decimal(18, 4)
  paymentTerms           String?
  deliveryTerms          String?
  deliveryAddress        String?
  agreedDeliveryDate     DateTime?
  notes                  String?
  closedAt               DateTime?
  closedById             String?
  closureNote            String?
  closureOverrideById    String?
  closureOverrideReason  String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  lines                  SalesOrderLine[]
  purchaseOrders         PurchaseOrder[]
  deliveries             Delivery[]
  invoices               CustomerInvoice[]
  discrepancies          OrderDiscrepancy[]
  statusEvents           OrderStatusEvent[]

  @@unique([organizationId, orderNumber])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status])
  @@index([quotationId])
  @@index([customerId])
}

model SalesOrderLine {
  id                      String                @id @default(cuid())
  organizationId          String                @default("__unset__")
  organization            Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesOrderId            String
  salesOrder              SalesOrder            @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  lineNo                  Int
  enquiryItemId           String?
  enquiryItem             EnquiryItem?          @relation(fields: [enquiryItemId], references: [id], onDelete: SetNull)
  customerQuotationItemId String?
  productId               String?
  supplierOfferId         String?
  description             String
  specs                   String?
  quantity                Decimal               @db.Decimal(18, 4)
  unit                    String                @default("pcs")
  unitPrice               Decimal               @db.Decimal(18, 4)
  discountPct             Decimal               @default(0) @db.Decimal(9, 4)
  discountAmount          Decimal               @default(0) @db.Decimal(18, 4)
  taxRatePct              Decimal               @default(0) @db.Decimal(9, 4)
  taxAmount               Decimal               @default(0) @db.Decimal(18, 4)
  lineTotal               Decimal               @default(0) @db.Decimal(18, 4)
  stockQuantity           Decimal               @default(0) @db.Decimal(18, 4)
  procureQuantity         Decimal               @default(0) @db.Decimal(18, 4)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  purchaseOrderLines      PurchaseOrderLine[]
  deliveryLines           DeliveryLine[]
  invoiceLines            CustomerInvoiceLine[]

  @@unique([salesOrderId, lineNo])
  @@index([organizationId, salesOrderId])
  @@index([enquiryItemId])
}

model PurchaseOrder {
  id                   String                    @id @default(cuid())
  organizationId       String                    @default("__unset__")
  organization         Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  poNumber             String
  idempotencyKey       String
  version              Int                       @default(1)
  status               String                    @default("AWAITING_APPROVAL")
  // AWAITING_APPROVAL | APPROVED | SENT | ACKNOWLEDGED | PARTIALLY_ACKNOWLEDGED | REJECTED | REVISED | PARTIALLY_RECEIVED | RECEIVED | COMPLETED | CANCELLED
  salesOrderId         String
  salesOrder           SalesOrder                @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  supplierId           String
  supplier             Supplier                  @relation(fields: [supplierId], references: [id])
  currency             String
  subtotal             Decimal                   @default(0) @db.Decimal(18, 4)
  taxAmount            Decimal                   @default(0) @db.Decimal(18, 4)
  total                Decimal                   @default(0) @db.Decimal(18, 4)
  paymentTerms         String?
  deliveryTerms        String?
  deliveryLocation     String?
  expectedDeliveryDate DateTime?
  supplierNotes        String?
  internalNotes        String?
  approvedById         String?
  approvedAt           DateTime?
  sentAt               DateTime?
  sentChannel          String?
  sentTo               String?
  providerMessageId    String?
  sentSubject          String?
  sentDocumentJson     String?
  lastError            String?
  createdById          String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  lines                PurchaseOrderLine[]
  acknowledgements     SupplierAcknowledgement[]
  receipts             GoodsReceipt[]
  supplierBills        SupplierBill[]

  @@unique([organizationId, poNumber])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status])
  @@index([salesOrderId])
  @@index([supplierId])
}

model PurchaseOrderLine {
  id               String             @id @default(cuid())
  organizationId   String             @default("__unset__")
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  salesOrderLineId String
  salesOrderLine   SalesOrderLine     @relation(fields: [salesOrderLineId], references: [id], onDelete: Cascade)
  supplierOfferId  String?
  supplierOffer    SupplierOffer?     @relation(fields: [supplierOfferId], references: [id], onDelete: SetNull)
  lineNo           Int
  description      String
  specs            String?
  quantity         Decimal            @db.Decimal(18, 4)
  unit             String             @default("pcs")
  unitPrice        Decimal            @db.Decimal(18, 4)
  taxRatePct       Decimal            @default(0) @db.Decimal(9, 4)
  taxAmount        Decimal            @default(0) @db.Decimal(18, 4)
  lineTotal        Decimal            @default(0) @db.Decimal(18, 4)
  moq              Decimal?           @db.Decimal(18, 4)
  leadTimeDays     Int?
  createdAt        DateTime           @default(now())
  receiptLines     GoodsReceiptLine[]

  @@unique([purchaseOrderId, lineNo])
  @@index([organizationId, purchaseOrderId])
  @@index([salesOrderLineId])
}

model SupplierAcknowledgement {
  id              String        @id @default(cuid())
  organizationId  String        @default("__unset__")
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  outcome         String
  reviewStatus    String        @default("PENDING")
  promisedDate    DateTime?
  linesJson       String        @default("[]")
  deviationsJson  String        @default("[]")
  notes           String?
  evidenceJson    String        @default("{}")
  source          String        @default("MANUAL")
  recordedById    String?
  receivedAt      DateTime      @default(now())
  reviewedById    String?
  reviewedAt      DateTime?
  reviewNote      String?
  createdAt       DateTime      @default(now())

  @@index([organizationId, reviewStatus])
  @@index([purchaseOrderId, createdAt])
}

model GoodsReceipt {
  id               String             @id @default(cuid())
  organizationId   String             @default("__unset__")
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  receiptNumber    String
  idempotencyKey   String
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  supplierId       String
  receivedAt       DateTime           @default(now())
  deliveryNoteRef  String?
  condition        String             @default("OK")
  inspectionResult String?
  notes            String?
  photoPath        String?
  recordedById     String?
  createdAt        DateTime           @default(now())
  lines            GoodsReceiptLine[]

  @@unique([organizationId, receiptNumber])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, purchaseOrderId])
}

model GoodsReceiptLine {
  id                  String            @id @default(cuid())
  organizationId      String            @default("__unset__")
  organization        Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  goodsReceiptId      String
  goodsReceipt        GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderLineId String
  purchaseOrderLine   PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Cascade)
  quantityOrdered     Decimal           @db.Decimal(18, 4)
  quantityReceived    Decimal           @db.Decimal(18, 4)
  quantityAccepted    Decimal           @default(0) @db.Decimal(18, 4)
  quantityRejected    Decimal           @default(0) @db.Decimal(18, 4)
  batchNo             String?
  condition           String            @default("OK")
  inspectionResult    String?
  discrepancyType     String?
  discrepancyNote     String?
  createdAt           DateTime          @default(now())

  @@index([organizationId, goodsReceiptId])
  @@index([purchaseOrderLineId])
}

model Delivery {
  id                  String         @id @default(cuid())
  organizationId      String         @default("__unset__")
  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveryNumber      String
  idempotencyKey      String
  salesOrderId        String
  salesOrder          SalesOrder     @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  status              String         @default("DISPATCHED")
  dispatchedAt        DateTime       @default(now())
  deliveredAt         DateTime?
  carrier             String?
  vehicleRef          String?
  trackingRef         String?
  deliveryAddress     String?
  proofOfDeliveryPath String?
  receivedBy          String?
  notes               String?
  recordedById        String?
  createdAt           DateTime       @default(now())
  lines               DeliveryLine[]

  @@unique([organizationId, deliveryNumber])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, salesOrderId])
}

model DeliveryLine {
  id               String         @id @default(cuid())
  organizationId   String         @default("__unset__")
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveryId       String
  delivery         Delivery       @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  salesOrderLineId String
  salesOrderLine   SalesOrderLine @relation(fields: [salesOrderLineId], references: [id], onDelete: Cascade)
  quantity         Decimal        @db.Decimal(18, 4)
  createdAt        DateTime       @default(now())

  @@index([organizationId, deliveryId])
  @@index([salesOrderLineId])
}

model CustomerInvoice {
  id             String                @id @default(cuid())
  organizationId String                @default("__unset__")
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceNumber  String
  idempotencyKey String
  salesOrderId   String
  salesOrder     SalesOrder            @relation(fields: [salesOrderId], references: [id])
  customerId     String?
  customer       Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status         String                @default("ISSUED")
  invoiceDate    DateTime              @default(now())
  dueDate        DateTime?
  currency       String
  subtotal       Decimal               @db.Decimal(18, 4)
  discountTotal  Decimal               @default(0) @db.Decimal(18, 4)
  taxAmount      Decimal               @db.Decimal(18, 4)
  taxLabel       String?
  taxRatePct     Decimal               @default(0) @db.Decimal(9, 4)
  total          Decimal               @db.Decimal(18, 4)
  amountPaid     Decimal               @default(0) @db.Decimal(18, 4)
  deliveryId     String?
  notes          String?
  issuedById     String?
  issuedAt       DateTime              @default(now())
  createdAt      DateTime              @default(now())
  lines          CustomerInvoiceLine[]
  allocations    PaymentAllocation[]

  @@unique([organizationId, invoiceNumber])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status])
  @@index([salesOrderId])
  @@index([customerId])
}

model CustomerInvoiceLine {
  id               String          @id @default(cuid())
  organizationId   String          @default("__unset__")
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceId        String
  invoice          CustomerInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  salesOrderLineId String?
  salesOrderLine   SalesOrderLine? @relation(fields: [salesOrderLineId], references: [id], onDelete: SetNull)
  description      String
  quantity         Decimal         @db.Decimal(18, 4)
  unit             String          @default("pcs")
  unitPrice        Decimal         @db.Decimal(18, 4)
  discountPct      Decimal         @default(0) @db.Decimal(9, 4)
  discountAmount   Decimal         @default(0) @db.Decimal(18, 4)
  taxRatePct       Decimal         @default(0) @db.Decimal(9, 4)
  taxAmount        Decimal         @default(0) @db.Decimal(18, 4)
  lineTotal        Decimal         @db.Decimal(18, 4)
  createdAt        DateTime        @default(now())

  @@index([organizationId, invoiceId])
}

model CustomerPayment {
  id             String              @id @default(cuid())
  organizationId String              @default("__unset__")
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  paymentNumber  String
  idempotencyKey String
  customerId     String?
  customer       Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  amount         Decimal             @db.Decimal(18, 4)
  currency       String
  receivedAt     DateTime            @default(now())
  method         String              @default("BANK_TRANSFER")
  reference      String?
  proofPath      String?
  notes          String?
  status         String              @default("CONFIRMED")
  recordedById   String?
  reversedById   String?
  reversedAt     DateTime?
  reversalReason String?
  createdAt      DateTime            @default(now())
  allocations    PaymentAllocation[]

  @@unique([organizationId, paymentNumber])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status])
  @@index([customerId])
}

model PaymentAllocation {
  id             String          @id @default(cuid())
  organizationId String          @default("__unset__")
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  paymentId      String
  payment        CustomerPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId      String
  invoice        CustomerInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount         Decimal         @db.Decimal(18, 4)
  createdAt      DateTime        @default(now())

  @@unique([paymentId, invoiceId])
  @@index([organizationId, invoiceId])
}

model SupplierBill {
  id                 String            @id @default(cuid())
  organizationId     String            @default("__unset__")
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  billNumber         String
  idempotencyKey     String
  supplierId         String
  supplier           Supplier          @relation(fields: [supplierId], references: [id])
  purchaseOrderId    String?
  purchaseOrder      PurchaseOrder?    @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  goodsReceiptId     String?
  supplierInvoiceRef String?
  status             String            @default("OPEN")
  currency           String
  amount             Decimal           @db.Decimal(18, 4)
  taxAmount          Decimal           @default(0) @db.Decimal(18, 4)
  total              Decimal           @db.Decimal(18, 4)
  paidAmount         Decimal           @default(0) @db.Decimal(18, 4)
  dueDate            DateTime?
  paymentTerms       String?
  receivedAt         DateTime          @default(now())
  notes              String?
  recordedById       String?
  createdAt          DateTime          @default(now())
  payments           SupplierPayment[]

  @@unique([organizationId, billNumber])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status])
  @@index([supplierId])
  @@index([purchaseOrderId])
}

model SupplierPayment {
  id             String       @id @default(cuid())
  organizationId String       @default("__unset__")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  paymentNumber  String
  idempotencyKey String
  supplierBillId String
  supplierBill   SupplierBill @relation(fields: [supplierBillId], references: [id], onDelete: Cascade)
  amount         Decimal      @db.Decimal(18, 4)
  currency       String
  paidAt         DateTime     @default(now())
  method         String       @default("BANK_TRANSFER")
  reference      String?
  proofPath      String?
  notes          String?
  status         String       @default("CONFIRMED")
  recordedById   String?
  reversedById   String?
  reversedAt     DateTime?
  reversalReason String?
  createdAt      DateTime     @default(now())

  @@unique([organizationId, paymentNumber])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, supplierBillId])
}

model OrderStatusEvent {
  id             String       @id @default(cuid())
  organizationId String       @default("__unset__")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entityType     String
  entityId       String
  fromStatus     String?
  toStatus       String
  reason         String?
  actorId        String?
  actorLabel     String       @default("system")
  metaJson       String       @default("{}")
  createdAt      DateTime     @default(now())
  salesOrder     SalesOrder?  @relation(fields: [salesOrderId], references: [id])
  salesOrderId   String?

  @@index([organizationId, entityType, entityId])
  @@index([organizationId, createdAt])
}

model OrderDiscrepancy {
  id             String       @id @default(cuid())
  organizationId String       @default("__unset__")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entityType     String
  entityId       String
  salesOrderId   String?
  salesOrder     SalesOrder?  @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  code           String
  severity       String       @default("BLOCKING")
  status         String       @default("OPEN")
  detailJson     String       @default("{}")
  note           String?
  resolvedById   String?
  resolvedAt     DateTime?
  resolutionNote String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, status])
  @@index([entityType, entityId])
  @@index([salesOrderId])
}
