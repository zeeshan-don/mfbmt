{
  "$schema": "openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "crons": [
    { "path": "/api/cron/process-jobs", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/email-sync", "schedule": "*/5 * * * *" }
  ],
  "daemons": {
    "worker": {
      "root": ".",
      "entrypoint": "Dockerfile.worker",
      "instances": {
        "iad1": 1
      },
      "livenessProbe": {
        "httpGet": { "port": 3001, "path": "/health" },
        "initialDelaySeconds": 10
      }
    }
  }
}
